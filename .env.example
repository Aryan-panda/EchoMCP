# EchoMCP Environment Configuration
APP_ENV=development

# MCP Server
MCP_HOST=0.0.0.0
MCP_PORT=3001
MCP_AUTH_TOKEN=change-me-to-a-secure-token

# TTS Provider (CosyVoice-300M-Instruct)
TTS_HOST=0.0.0.0
TTS_PORT=8080
TTS_BASE_URL=http://tts:8080
TTS_DEVICE=cuda
COSYVOICE_MODEL=CosyVoice-300M-Instruct

# Audio Defaults
DEFAULT_VOICE_ID=1
MAX_TEXT_LENGTH=5000
MAX_AUDIO_SECONDS=120
DEFAULT_AUDIO_FORMAT=wav
DEFAULT_SPEED=1.0

# Storage & Retention
AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_DAYS=30

# Observability
LOG_LEVEL=INFO
